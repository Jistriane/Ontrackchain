# ============================================================
# report-api — .env.example (Sprint S28+23.2)
# Descrição: Relatórios regulatórios, LGPD Art.37 ROPD, Strong Auth
# Porta padrão: 8004
# Uso: copiar para .env no diretório apps/report-api/ ou usar .env raiz.
# ============================================================

# ─── Porta e Runtime ────────────────────────────────────────
REPORT_API_PORT=8004
APP_ENV=local

# ─── Postgres (RLS Multi-Tenant, comum a 9/9 serviços) ────
POSTGRES_USER=ontrackchain
POSTGRES_PASSWORD=ontrackchain
POSTGRES_DB=ontrackchain
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis (cache / rate limit / billing, opcional) ────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── RBAC / JWT (ADR-018 Shared First) ────────────────────
# OTK_AUDIENCE=ontrackchain-api  (descomente se diferente de JWT_AUDIENCE)
JWT_ISSUER=ontrackchain
JWT_AUDIENCE=ontrackchain
JWT_HS256_SECRET=change-me
OIDC_JWKS_URL=http://keycloak:8080/realms/ontrackchain/protocol/openid-connect/certs

# ─── Variáveis ESPECÍFICAS de report-api ─────────────────────
REPORT_INTERNAL_METRICS_ENABLED=true
REPORT_DOWNLOADS_LAST_24H_WARN_THRESHOLD=10
REPORT_PENDING_ONCHAIN_WARN_THRESHOLD=3
REPORT_LEGAL_DOWNLOAD_SECURITY_VIOLATION_THRESHOLD=1
REPORT_PERSISTED_WITHOUT_DOWNLOAD_WARN_THRESHOLD=3
# REPORT_STRONG_AUTH_WEBAUTHN_RP_ID=<específico do serviço report-api>
# REPORT_STRONG_AUTH_YUBIKEY_AAT_REQUIRED=<específico do serviço report-api>

# ─── Fim do arquivo ────────────────────────────────────────
