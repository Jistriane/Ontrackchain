# ============================================================
# case-management — .env.example (Sprint S28+23.2)
# Descrição: Gestão de casos, workflows, atribuições, auditoria
# Porta padrão: 8006
# Uso: copiar para .env no diretório apps/case-management/ ou usar .env raiz.
# ============================================================

# ─── Porta e Runtime ────────────────────────────────────────
APP_ENV=local

# ─── Postgres (RLS Multi-Tenant, comum a 9/9 serviços) ────
POSTGRES_USER=ontrackchain
POSTGRES_PASSWORD=ontrackchain
POSTGRES_DB=ontrackchain
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis (cache / rate limit / billing, opcional) ────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── RBAC / JWT (ADR-018 Shared First) ────────────────────
# OTK_AUDIENCE=ontrackchain-api  (descomente se diferente de JWT_AUDIENCE)
JWT_ISSUER=ontrackchain
JWT_AUDIENCE=ontrackchain
JWT_HS256_SECRET=change-me
OIDC_JWKS_URL=http://keycloak:8080/realms/ontrackchain/protocol/openid-connect/certs

# ─── Variáveis ESPECÍFICAS de case-management ─────────────────────
# AI_SERVICE_URL=<específico do serviço case-management>
# CASE_WORKER_POOL_SIZE=<específico do serviço case-management>

# ─── Fim do arquivo ────────────────────────────────────────
