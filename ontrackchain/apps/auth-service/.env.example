# ============================================================
# auth-service — .env.example (Sprint S28+23.2)
# Descrição: JWT, MFA TOTP, OIDC Provider, Roles/Federated Login
# Porta padrão: 9000
# Uso: copiar para .env no diretório apps/auth-service/ ou usar .env raiz.
# ============================================================

# ─── Porta e Runtime ────────────────────────────────────────
AUTH_SERVICE_PORT=9000
APP_ENV=local

# ─── Postgres (RLS Multi-Tenant, comum a 9/9 serviços) ────
POSTGRES_USER=ontrackchain
POSTGRES_PASSWORD=ontrackchain
POSTGRES_DB=ontrackchain
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis (cache / rate limit / billing, opcional) ────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── RBAC / JWT (ADR-018 Shared First) ────────────────────
# OTK_AUDIENCE=ontrackchain-api  (descomente se diferente de JWT_AUDIENCE)
JWT_ISSUER=ontrackchain
JWT_AUDIENCE=ontrackchain
JWT_HS256_SECRET=change-me
OIDC_PROVIDER=keycloak
OIDC_ISSUER_URL=http://auth.localhost:8080/realms/ontrackchain
OIDC_AUDIENCE=ontrackchain-api
OIDC_CLIENT_ID=ontrackchain-web
OIDC_JWKS_URL=http://keycloak:8080/realms/ontrackchain/protocol/openid-connect/certs
OIDC_ORG_CLAIM=org
OIDC_PLAN_CLAIM=plan
OIDC_ROLE_CLAIM=otk_role

# ─── Variáveis ESPECÍFICAS de auth-service ─────────────────────
AUTH_MODE=dev
DEV_AUTH_ENABLED=true
MFA_TOTP_SECRET=JBSWY3DPEHPK3PXP
MFA_TOTP_ISSUER=OnTrackChain
MFA_TOTP_ACCOUNT_NAME=local-admin@ontrackchain
MFA_TOTP_PERIOD_SECONDS=30
MFA_TOTP_DIGITS=6
MFA_TOTP_WINDOW=1
MFA_EXTERNAL_PROVIDER_HOMOLOGATED=false
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=ontrackchain
KEYCLOAK_HOSTNAME=auth.localhost
KEYCLOAK_PUBLIC_URL=http://auth.localhost:8080
KEYCLOAK_B2B_CLIENT_SECRET=change-me-b2b-secret
INTERNAL_KEYCLOAK_BASE_URL=http://keycloak:8080

# ─── Fim do arquivo ────────────────────────────────────────
