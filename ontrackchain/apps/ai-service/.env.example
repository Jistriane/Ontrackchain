# ============================================================
# ai-service — .env.example (Sprint S28+23.2)
# Descrição: XAI, Graph Intelligence, THEMIS Agent, Law Enforcement Export
# Porta padrão: 8005
# Uso: copiar para .env no diretório apps/ai-service/ ou usar .env raiz.
# ============================================================

# ─── Porta e Runtime ────────────────────────────────────────
APP_ENV=local

# ─── Postgres (RLS Multi-Tenant, comum a 9/9 serviços) ────
POSTGRES_USER=ontrackchain
POSTGRES_PASSWORD=ontrackchain
POSTGRES_DB=ontrackchain
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis (cache / rate limit / billing, opcional) ────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── RBAC / JWT (ADR-018 Shared First) ────────────────────
# OTK_AUDIENCE=ontrackchain-api  (descomente se diferente de JWT_AUDIENCE)
JWT_ISSUER=ontrackchain
JWT_AUDIENCE=ontrackchain
JWT_HS256_SECRET=change-me
OIDC_JWKS_URL=http://keycloak:8080/realms/ontrackchain/protocol/openid-connect/certs

# ─── Variáveis ESPECÍFICAS de ai-service ─────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5
ANTHROPIC_TIMEOUT_MS=3500
GROQ_API_KEY=your-groq-api-key-here
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=3500
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_LATENCY_THRESHOLD_MS=3500
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600
RAG_VECTOR_STORE=pgvector
RAG_EMBEDDING_MODEL=voyage-3
RAG_EMBEDDING_DIMENSIONS=1024
RAG_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.7
RAG_RERANK_ENABLED=true
RAG_CORPUS_VERSION=1.0.0
VOYAGE_API_KEY=your-voyageai-api-key-here
EVAL_SAMPLING_RATE=0.05
EVAL_GOLDEN_DATASET_SIZE=100
EVAL_REGRESSION_BLOCKING=true
EVAL_TARGET_PRECISION=0.90
EVAL_TARGET_RECALL=0.85
EVAL_REVIEW_REQUIRED=true
LLM_ZERO_RETENTION=true
LLM_ANONYMIZE_INPUTS=true
LLM_MAX_INPUT_LENGTH=8192
LLM_LOG_PROMPTS=false
LLM_LOG_RESPONSES=false
# AI_WORKER_ORG_ID=<específico do serviço ai-service>
# AI_SERVICE_URL=<específico do serviço ai-service>

# ─── Fim do arquivo ────────────────────────────────────────
