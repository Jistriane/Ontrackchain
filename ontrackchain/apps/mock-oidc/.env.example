# ============================================================
# mock-oidc — .env.example (Sprint S28+23.2)
# Descrição: OIDC Provider mock p/ homologação local (pydantic Settings)
# Porta padrão: 9101
# Uso: copiar para .env no diretório apps/mock-oidc/ ou usar .env raiz.
# ============================================================

# ─── Porta e Runtime ────────────────────────────────────────
APP_ENV=local

# ─── Postgres (RLS Multi-Tenant, comum a 9/9 serviços) ────
POSTGRES_USER=ontrackchain
POSTGRES_PASSWORD=ontrackchain
POSTGRES_DB=ontrackchain
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis (cache / rate limit / billing, opcional) ────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── RBAC / JWT (ADR-018 Shared First) ────────────────────
# OTK_AUDIENCE=ontrackchain-api  (descomente se diferente de JWT_AUDIENCE)
JWT_ISSUER=ontrackchain
JWT_AUDIENCE=ontrackchain
JWT_HS256_SECRET=change-me
OIDC_JWKS_URL=http://keycloak:8080/realms/ontrackchain/protocol/openid-connect/certs

# ─── Variáveis ESPECÍFICAS de mock-oidc ─────────────────────
MOCK_OIDC_ISSUER_URL=http://oidc.localhost:8080
MOCK_OIDC_AUDIENCE=ontrackchain-api
MOCK_OIDC_CLIENT_ID=ontrackchain-web
# MOCK_OIDC_USER_POOL_JSON_PATH=<específico do serviço mock-oidc>
# MOCK_OIDC_SIGNING_PRIVATE_KEY_PEM_PATH=<específico do serviço mock-oidc>
# MOCK_OIDC_EXTRA_SCOPES=<específico do serviço mock-oidc>

# ─── Fim do arquivo ────────────────────────────────────────
