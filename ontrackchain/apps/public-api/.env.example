# ============================================================
# public-api — .env.example (Sprint S28+23.2)
# Descrição: Public/Public API B2B, rate limit, screens públicas
# Porta padrão: 8000
# Uso: copiar para .env no diretório apps/public-api/ ou usar .env raiz.
# ============================================================

# ─── Porta e Runtime ────────────────────────────────────────
PUBLIC_API_PORT=8000
APP_ENV=local

# ─── Postgres (RLS Multi-Tenant, comum a 9/9 serviços) ────
POSTGRES_USER=ontrackchain
POSTGRES_PASSWORD=ontrackchain
POSTGRES_DB=ontrackchain
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis (cache / rate limit / billing, opcional) ────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── RBAC / JWT (ADR-018 Shared First) ────────────────────
# OTK_AUDIENCE=ontrackchain-api  (descomente se diferente de JWT_AUDIENCE)
JWT_ISSUER=ontrackchain
JWT_AUDIENCE=ontrackchain
JWT_HS256_SECRET=change-me
OIDC_JWKS_URL=http://keycloak:8080/realms/ontrackchain/protocol/openid-connect/certs
OIDC_AUDIENCE=ontrackchain-api
OIDC_ISSUER_URL=http://auth.localhost:8080/realms/ontrackchain

# ─── Variáveis ESPECÍFICAS de public-api ─────────────────────
INTERNAL_API_BASE_URL=http://traefik
INTERNAL_AUTH_BASE_URL=http://auth-service:9000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# B2B_API_KEY_SECRET_PEPPER=<específico do serviço public-api>

# ─── Fim do arquivo ────────────────────────────────────────
