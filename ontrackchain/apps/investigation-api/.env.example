# ============================================================
# investigation-api — .env.example (Sprint S28+23.2)
# Descrição: Investigações, selos SHA256+HMAC, Stripe billing, RPC
# Porta padrão: 8001
# Uso: copiar para .env no diretório apps/investigation-api/ ou usar .env raiz.
# ============================================================

# ─── Porta e Runtime ────────────────────────────────────────
INVESTIGATION_API_PORT=8001
APP_ENV=local

# ─── Postgres (RLS Multi-Tenant, comum a 9/9 serviços) ────
POSTGRES_USER=ontrackchain
POSTGRES_PASSWORD=ontrackchain
POSTGRES_DB=ontrackchain
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis (cache / rate limit / billing, opcional) ────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── RBAC / JWT (ADR-018 Shared First) ────────────────────
# OTK_AUDIENCE=ontrackchain-api  (descomente se diferente de JWT_AUDIENCE)
JWT_ISSUER=ontrackchain
JWT_AUDIENCE=ontrackchain
JWT_HS256_SECRET=change-me
OIDC_JWKS_URL=http://keycloak:8080/realms/ontrackchain/protocol/openid-connect/certs

# ─── Variáveis ESPECÍFICAS de investigation-api ─────────────────────
CREDIT_VALUE_BRL=1.0
INVESTIGATION_INTERNAL_METRICS_ENABLED=true
INVESTIGATION_WORKER_PROCESSING_SECONDS=2
INVESTIGATION_WORKER_LOCAL_CONCURRENCY=8
INVESTIGATION_WORKER_BASE_BACKOFF_SECONDS=5
INVESTIGATION_RPC_PROVIDER=evm_rpc
INVESTIGATION_RPC_ENABLED=false
INVESTIGATION_RPC_PRIMARY_URL=
INVESTIGATION_RPC_FALLBACK_URL=
INVESTIGATION_RPC_TIMEOUT_MS=1500
INVESTIGATION_RPC_MAX_RETRIES=1
INVESTIGATION_INTERNAL_WORKER_TOKEN=investigation-local-token
# STRIPE_SECRET_KEY=<específico do serviço investigation-api>
# STRIPE_WEBHOOK_SECRET=<específico do serviço investigation-api>
# STRIPE_MODE=<específico do serviço investigation-api>

# ─── Fim do arquivo ────────────────────────────────────────
