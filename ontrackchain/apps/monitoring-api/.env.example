# ============================================================
# monitoring-api — .env.example (Sprint S28+23.2)
# Descrição: SLA, métricas, alertas P0/P1/P2, Alertmanager webhook
# Porta padrão: 8003
# Uso: copiar para .env no diretório apps/monitoring-api/ ou usar .env raiz.
# ============================================================

# ─── Porta e Runtime ────────────────────────────────────────
MONITORING_API_PORT=8003
APP_ENV=local

# ─── Postgres (RLS Multi-Tenant, comum a 9/9 serviços) ────
POSTGRES_USER=ontrackchain
POSTGRES_PASSWORD=ontrackchain
POSTGRES_DB=ontrackchain
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis (cache / rate limit / billing, opcional) ────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── RBAC / JWT (ADR-018 Shared First) ────────────────────
# OTK_AUDIENCE=ontrackchain-api  (descomente se diferente de JWT_AUDIENCE)
JWT_ISSUER=ontrackchain
JWT_AUDIENCE=ontrackchain
JWT_HS256_SECRET=change-me
OIDC_JWKS_URL=http://keycloak:8080/realms/ontrackchain/protocol/openid-connect/certs

# ─── Variáveis ESPECÍFICAS de monitoring-api ─────────────────────
MONITORING_INTERNAL_METRICS_ENABLED=true
MONITORING_ALERTS_LAST_HOUR_WARN_THRESHOLD=5
MONITORING_CRITICAL_ALERTS_LAST_24H_CRITICAL_THRESHOLD=1
MONITORING_EXPIRED_QUOTES_WARN_THRESHOLD=10
MONITORING_OPEN_QUOTES_WARN_THRESHOLD=25
ALERTMANAGER_WEBHOOK_BEARER_TOKEN=alertmanager-local-token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ANONYMOUS_ENABLED=false
GRAFANA_DISABLE_LOGIN_FORM=false

# ─── Fim do arquivo ────────────────────────────────────────
