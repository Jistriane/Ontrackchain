# ============================================================
# compliance-api — .env.example (Sprint S28+23.2)
# Descrição: Structural Screens RIPD Art.15, TRM Labs, Sanctions OFAC/EU
# Porta padrão: 8002
# Uso: copiar para .env no diretório apps/compliance-api/ ou usar .env raiz.
# ============================================================

# ─── Porta e Runtime ────────────────────────────────────────
COMPLIANCE_API_PORT=8002
APP_ENV=local

# ─── Postgres (RLS Multi-Tenant, comum a 9/9 serviços) ────
POSTGRES_USER=ontrackchain
POSTGRES_PASSWORD=ontrackchain
POSTGRES_DB=ontrackchain
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis (cache / rate limit / billing, opcional) ────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── RBAC / JWT (ADR-018 Shared First) ────────────────────
# OTK_AUDIENCE=ontrackchain-api  (descomente se diferente de JWT_AUDIENCE)
JWT_ISSUER=ontrackchain
JWT_AUDIENCE=ontrackchain
JWT_HS256_SECRET=change-me
OIDC_JWKS_URL=http://keycloak:8080/realms/ontrackchain/protocol/openid-connect/certs

# ─── Variáveis ESPECÍFICAS de compliance-api ─────────────────────
COMPLIANCE_INTERNAL_METRICS_ENABLED=true
COMPLIANCE_QUEUED_CASES_WARN_THRESHOLD=5
COMPLIANCE_FAILED_LAST_24H_CRITICAL_THRESHOLD=1
COMPLIANCE_EXPIRED_QUOTES_WARN_THRESHOLD=10
COMPLIANCE_COMPLETED_WITHOUT_REPORT_WARN_THRESHOLD=3
COMPLIANCE_PROVIDER_DEGRADED_WARN_THRESHOLD=1
COMPLIANCE_RISK_PROVIDER=trm_labs
COMPLIANCE_TRM_ENABLED=false
COMPLIANCE_TRM_SCREENING_URL=
COMPLIANCE_TRM_API_KEY=
COMPLIANCE_TRM_API_KEY_HEADER=Authorization
COMPLIANCE_TRM_API_KEY_PREFIX=Bearer
COMPLIANCE_TRM_TIMEOUT_MS=1500
COMPLIANCE_TRM_MAX_RETRIES=1
COMPLIANCE_OFAC_SDN_SOURCE_URL=
COMPLIANCE_EU_SANCTIONS_SOURCE_URL=

# ─── Fim do arquivo ────────────────────────────────────────
