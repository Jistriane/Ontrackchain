# Patterns/Documentos que NAO devem entrar no pacote Helm Chart
# Apenas paths relativos ao DIRETORIO DO CHART (nao use paths fora daqui!)
.git/
.gitignore
.github/
.vscode/
.idea/
*.pyc
*.pyo
__pycache__/
*.md
# Dados sensiveis (nunca commitados, mas helm ignora tambem)
*.env
*.env.*
.secrets
*.pem
*.key
# Arquivos locais de dev
Dockerfile.local
docker-compose*.yml
# Binarios / logs / tmp (fora do chart sempre)
*.log
tmp/
ci-artifacts/
