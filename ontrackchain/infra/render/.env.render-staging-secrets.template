#
# OnTrackChain — Render Full Stack Staging Deploy (.env TEMPLATE — preencha no Render Dashboard Sync Environment Groups)
#
# COMO USAR:
# 1. Clique no blueprint render.yaml aplicado na sua conta Render.
# 2. Na área "Environment Groups" do serviço no painel, crie um env group chamado `ontrackchain-staging-secrets` (sync: true).
# 3. Copie cada chave abaixo e cole no dashboard com seus valores reais.
# 4. NÃO coloque este arquivo em git.
#
# ───────────────────────────────────────────────────────────────────────────────────────────
# BLOCO 1 — SEGURANÇA CORE (P0)
# ───────────────────────────────────────────────────────────────────────────────────────────

# Segredo de assinatura JWT HS256 usado por auth-service, gateway e demais serviços.
# Mínimo 64 bytes hex. Gere local com: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_HS256_SECRET=

# Segredo TOTP MFA. 32 caracteres base32. Gere: python3 -c "import pyotp; print(pyotp.random_base32())"
MFA_TOTP_SECRET=

# Senha admin do Keycloak (usuário admin) — 16+ chars alfanum + símbolos
KEYCLOAK_ADMIN_PASSWORD=

# ───────────────────────────────────────────────────────────────────────────────────────────
# BLOCO 2 — KEYCLOAK USUÁRIOS PADRÃO (staging) — sincronizar sync:true
# ───────────────────────────────────────────────────────────────────────────────────────────
# Para staging, gere passwords únicas 12 chars e coloque aqui.
# Ou gere via comando:  python3 -c "import secrets; print(secrets.token_urlsafe(12))"
KEYCLOAK_DEFAULT_USER_SYSTEM_PASSWORD=
KEYCLOAK_DEFAULT_USER_JIBSO_PASSWORD=
KEYCLOAK_DEFAULT_USER_ANALYST_PASSWORD=
KEYCLOAK_DEFAULT_USER_AUDITOR_PASSWORD=
KEYCLOAK_DEFAULT_USER_KMD_PASSWORD=
KEYCLOAK_DEFAULT_USER_VIEWER_PASSWORD=
KEYCLOAK_DEFAULT_USER_SEM_ORG_PASSWORD=

# ───────────────────────────────────────────────────────────────────────────────────────────
# BLOCO 2B — BANCOS DE DADOS (sync:false obrigatórios)
# ───────────────────────────────────────────────────────────────────────────────────────────
# Cada microserviço que usa Postgres tem seu próprio DB owner + senha 16 chars min.
# Gere localmente: for i in 1 2 3 4 5; do python3 -c "import secrets; print(secrets.token_urlsafe(12))"; done
KEYCLOAK_DB_PASSWORD=
AUTH_DB_PASSWORD=
CASE_DB_PASSWORD=
INV_DB_PASSWORD=
BILLING_DB_PASSWORD=
COMPLIANCE_DB_PASSWORD=
COUNTERPARTY_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
AUDIT_DB_PASSWORD=
ENTERPRISE_DB_PASSWORD=
SANCTIONS_DB_PASSWORD=
RISK_DB_PASSWORD=
MONITORING_DB_PASSWORD=
AI_DB_PASSWORD=
REPORTING_DB_PASSWORD=
EVENT_DB_PASSWORD=
TEAM_DB_PASSWORD=
EVIDENCE_DB_PASSWORD=
BLOCKCHAIN_DB_PASSWORD=
POSTGRES_PASSWORD=

# ───────────────────────────────────────────────────────────────────────────────────────────
# BLOCO 3 — INTELIGÊNCIA ARTIFICIAL + RAG (P1 IA funcionar)
# ───────────────────────────────────────────────────────────────────────────────────────────
# Anthropic Claude — exemplo de formato de chave: sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=
# Groq — exemplo de formato: gsk_xxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=
# Voyage embeddings — exemplo de formato: pa-xxxxxxxxxxxxxxxxxxxxxxxx
VOYAGE_API_KEY=

# Token interno para ai-worker se comunicar com investigation/counterparty async jobs.
# 64 chars. Geração: python3 -c "import secrets; print(secrets.token_hex(32))"
INVESTIGATION_INTERNAL_WORKER_TOKEN=

# ───────────────────────────────────────────────────────────────────────────────────────────
# BLOCO 4 — BLOCHCHAIN RPC + COMPLIANCE EXTERNA (P1 quebram investigation)
# ───────────────────────────────────────────────────────────────────────────────────────────
# URL RPC completa p/ redes (Infura/Alchemy/QuickNode).
# Ex: https://mainnet.infura.io/v3/<PROJECT_ID> ou https://eth-mainnet.g.alchemy.com/v2/<KEY>
INVESTIGATION_RPC_PRIMARY_URL=

# Compliance data providers
TRM_API_KEY=
OPENSANCTIONS_API_KEY=

# ───────────────────────────────────────────────────────────────────────────────────────────
# BLOCO 5 — BILLING STRIPE (OPCIONAL — se não preencher, continua fallback unlimited FREE staging)
# ───────────────────────────────────────────────────────────────────────────────────────────
# Exemplos de formato:
#   STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ───────────────────────────────────────────────────────────────────────────────────────────
# BLOCO 6 — DEPLOY AUTOMÁTICO (OPCIONAL — 1 clique sem abrir dashboard)
# ───────────────────────────────────────────────────────────────────────────────────────────
#
# Objetivo: bash infra/render/scripts/push-and-deploy.sh
#           — faz push git + trigger deploy via API Render SEM abrir browser.
#
# Como obter:
#   1. RENDER_API_KEY ......... Crie em https://dashboard.render.com/user/settings/api_keys
#                               Scope: Read + Write. Expire longe (1 ano). Formato: rnd_<64 chars hex>
#   2. RENDER_BLUEPRINT_ID ... Abra seu Blueprint no browser, copie da URL:
#      https://dashboard.render.com/blueprints/bp-<ID>
#      → valor é bp-xxxxxxxxxxxxxxxxxxxxxx
#   3. RENDER_OWNER_ID ........ (Opcional, só contas Team / Enterprise.)
#                               Contas pessoais → VAZIO.
RENDER_API_KEY=
RENDER_BLUEPRINT_ID=
RENDER_OWNER_ID=
